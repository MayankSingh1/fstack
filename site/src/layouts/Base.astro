---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { repoUrl, npmUrl, pkg } from '../lib/skills';

interface Props { title?: string; description?: string; active?: 'home' | 'docs' | 'skills' }
const {
  title = 'fstack — Design & frontend skills for AI coding agents',
  description = 'fstack is an open-source pack of agent skills for designers and frontend developers. One sticky router picks the right playbook and refuses to call work done without evidence. Works in Claude Code, Cursor, Codex and more.',
  active,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og-image.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#17130e" />
    <meta name="keywords" content="fstack, flash stack, agent skills, SKILL.md, claude code skills, cursor skills, codex skills, figma to code, accessibility audit, design system, ux copy, frontend workflow, AI coding agent" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="fstack" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="fstack home"><Logo /><span>fstack</span></a>
        <nav aria-label="Primary">
          <a href="/docs" aria-current={active === 'docs' ? 'page' : undefined}>Docs</a>
          <a href="/skills" aria-current={active === 'skills' ? 'page' : undefined}>Skills</a>
          <a href="/#install" class="hide-sm">Install</a>
          <a href={repoUrl} class="gh" aria-label="fstack on GitHub">
            <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="hide-sm">GitHub</span>
          </a>
          <button class="theme" type="button" aria-label="Toggle dark mode">
            <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <div class="wrap foot-inner">
        <div class="foot-brand">
          <a class="brand" href="/"><Logo size={22} /><span>fstack</span></a>
          <p>Flash stack. Agent skills for designers and frontend developers. MIT licensed, v{pkg.version}.</p>
        </div>
        <nav aria-label="Footer" class="foot-links">
          <div><h2>Product</h2><a href="/docs">Docs</a><a href="/skills">Skills catalog</a><a href="/#install">Install</a></div>
          <div><h2>Project</h2><a href={repoUrl}>GitHub</a><a href={npmUrl}>npm</a><a href={`${repoUrl}/issues`}>Issues</a></div>
          <div><h2>Credits</h2><a href="https://flaviocopes.com/pstack/">Modeled on pstack</a><a href={`${repoUrl}/blob/main/README.md#license`}>License</a></div>
        </nav>
      </div>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
        b.addEventListener('click', async () => {
          const text = b.dataset.copy || '';
          try { await navigator.clipboard.writeText(text); } catch (e) { return; }
          const label = b.querySelector('.copy-label');
          b.classList.add('copied');
          if (label) label.textContent = 'Copied';
          setTimeout(() => { b.classList.remove('copied'); if (label) label.textContent = 'Copy'; }, 1600);
        });
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--ink); color: var(--bg); padding: 8px 12px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }
  .nav { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid transparent; transition: border-color .2s; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; font-size: 18px; letter-spacing: -0.02em; text-decoration: none; }
  nav[aria-label='Primary'] { display: flex; align-items: center; gap: 4px; }
  nav[aria-label='Primary'] a, .theme { display: inline-flex; align-items: center; gap: 7px; height: 38px; padding: 0 12px; border-radius: 9px; text-decoration: none; font-size: 15px; color: var(--ink-2); background: none; border: 0; cursor: pointer; }
  nav[aria-label='Primary'] a:hover, .theme:hover { color: var(--ink); background: var(--bg-sunk); }
  nav[aria-label='Primary'] a[aria-current='page'] { color: var(--ink); }
  .theme { padding: 0 10px; }
  .i-moon { display: none; }
  :global(:root[data-theme='dark']) .i-sun { display: none; }
  :global(:root[data-theme='dark']) .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .i-sun { display: none; }
    :global(:root:not([data-theme='light'])) .i-moon { display: block; }
  }
  @media (max-width: 560px) { .hide-sm { display: none; } nav[aria-label='Primary'] a, .theme { padding: 0 9px; } }

  .foot { border-top: 1px solid var(--line); padding: 56px 0 64px; margin-top: 40px; }
  .foot-inner { display: flex; gap: 48px; justify-content: space-between; flex-wrap: wrap; }
  .foot-brand { max-width: 320px; }
  .foot-brand p { color: var(--ink-3); font-size: 14.5px; margin: 12px 0 0; }
  .foot-links { display: flex; gap: clamp(32px, 6vw, 72px); flex-wrap: wrap; }
  .foot-links div { display: flex; flex-direction: column; gap: 8px; }
  .foot-links h2 { font: 500 12.5px var(--font-mono); color: var(--ink-3); margin: 0 0 4px; }
  .foot-links a { text-decoration: none; font-size: 15px; color: var(--ink-2); }
  .foot-links a:hover { color: var(--ink); }
</style>
