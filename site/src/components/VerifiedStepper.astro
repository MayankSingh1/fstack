---
const steps = [
  { t: 'The default', d: 'The agent edits the button, says it matches, and moves on. No screenshot, no states, no record.' },
  { t: 'Routed', d: 'flash-mode reads the request and the principles, then picks the Visual Parity playbook.' },
  { t: 'Worked the list', d: 'Every step lands in the task list. Helpers like /a11y are called when a step needs them.' },
  { t: 'Proved it', d: 'A pixel diff runs before and after, on the real screen, across hover, focus and disabled states.' },
  { t: 'Logged it', d: 'The result, the evidence and any deviations go into the project changelog for the next session.' },
];
---
<div class="stepper" data-stepper>
  <ol class="list" role="tablist" aria-label="From vibe-coded to verified" aria-orientation="vertical">
    {steps.map((s, i) => (
      <li role="presentation">
        <button role="tab" type="button" id={`vs-tab-${i}`} aria-controls={`vs-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <span class="n">{i + 1}</span>
          <span><strong>{s.t}</strong><span class="d">{s.d}</span></span>
        </button>
      </li>
    ))}
  </ol>

  <div class="stage">
    <div class="screen" role="tabpanel" id="vs-panel-0" aria-labelledby="vs-tab-0">
      <div class="msg"><span class="who">agent</span><p>Done! I updated the button so it matches the Figma design. Let me know if you need anything else.</p></div>
      <ul class="miss">
        <li><span>?</span>Which Figma frame?</li>
        <li><span>?</span>Hover, focus and disabled states</li>
        <li><span>?</span>Proof it matches</li>
        <li><span>?</span>Anything recorded for next time</li>
      </ul>
    </div>
    <div class="screen" role="tabpanel" id="vs-panel-1" aria-labelledby="vs-tab-1" hidden>
      <div class="kv"><span>request</span><code>make this button match the Figma design</code></div>
      <div class="kv"><span>principles</span><code>prove-on-real-screen · tokens-over-hardcoded · states-are-design</code></div>
      <div class="kv hl"><span>playbook</span><code>Visual Parity  (12 steps)</code></div>
      <div class="kv"><span>helpers</span><code>/a11y · /changelog-notetaker</code></div>
      <div class="kv"><span>mode</span><code>sticky until you say “exit”</code></div>
    </div>
    <div class="screen" role="tabpanel" id="vs-panel-2" aria-labelledby="vs-tab-2" hidden>
      <ul class="todo">
        <li class="ok">Identify the source of truth <em>Button / Primary / L</em></li>
        <li class="ok">Capture design screenshot</li>
        <li class="ok">Capture implementation screenshot</li>
        <li class="ok">Run pixel-level diff</li>
        <li class="now">Apply fixes with tokens</li>
        <li>Verify all states</li>
        <li>Check responsive parity</li>
        <li>Record in changelog</li>
      </ul>
    </div>
    <div class="screen" role="tabpanel" id="vs-panel-3" aria-labelledby="vs-tab-3" hidden>
      <div class="diffs">
        <div class="row"><code>padding</code><span>14px → 12px</span><b class="fail">FAIL</b><b class="fixed">Fixed</b></div>
        <div class="row"><code>radius</code><span>6px → --radius-md (10px)</span><b class="fail">FAIL</b><b class="fixed">Fixed</b></div>
        <div class="row"><code>:focus-visible</code><span>no ring</span><b class="fail">FAIL</b><b class="fixed">Fixed</b></div>
        <div class="row"><code>:disabled</code><span>contrast 2.9:1</span><b class="warn">WARN</b><b class="fixed">Fixed</b></div>
      </div>
      <div class="rounds"><span>Diff 1 · 3 FAIL, 1 WARN</span><span class="pass">Diff 2 · 0 px</span></div>
    </div>
    <div class="screen" role="tabpanel" id="vs-panel-4" aria-labelledby="vs-tab-4" hidden>
      <pre class="log"><span class="c"># CHANGELOG.md</span>
<b>## 2026-11-25 · Visual Parity · Primary button</b>
- Matched Figma frame Button / Primary / L
- Swapped hard-coded radius for --radius-md
- Added :focus-visible ring (2px, --focus)
- Disabled contrast 2.9:1 → 4.6:1
- Evidence: diff-before.png, diff-after.png (0 px)
- Deviations: none</pre>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stepper]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role=tabpanel]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, n) => { t.setAttribute('aria-selected', String(n === i)); t.tabIndex = n === i ? 0 : -1; });
      panels.forEach((p, n) => { p.hidden = n !== i; });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(k)) {
          e.preventDefault();
          const d = k === 'ArrowDown' || k === 'ArrowRight' ? 1 : -1;
          select((i + d + tabs.length) % tabs.length, true);
        }
      });
    });
  });
</script>

<style>
  .stepper { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(20px, 4vw, 56px); align-items: start; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  [role=tab] { display: flex; gap: 14px; width: 100%; text-align: left; padding: 14px 16px; border-radius: var(--radius); border: 0; background: transparent; color: var(--ink-2); font: inherit; cursor: pointer; }
  [role=tab]:hover { background: var(--bg-sunk); }
  [role=tab][aria-selected='true'] { background: var(--bg-raised); box-shadow: var(--shadow); color: var(--ink); }
  .n { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font: 500 13px var(--font-mono); border: 1px solid var(--line-strong); }
  [aria-selected='true'] .n { background: var(--flash); border-color: var(--flash); color: var(--flash-ink); }
  strong { display: block; font-weight: 600; font-size: 16.5px; }
  .d { display: block; font-size: 14.5px; color: var(--ink-3); margin-top: 2px; }
  [aria-selected='true'] .d { color: var(--ink-2); }
  .stage { position: sticky; top: 88px; background: var(--code-bg); color: var(--code-ink); border-radius: var(--radius-lg); padding: clamp(18px, 3vw, 30px); min-height: 380px; font-family: var(--font-mono); font-size: 13.5px; }
  .screen { animation: in .3s ease both; }
  @keyframes in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .screen { animation: none; } }
  .msg { display: flex; gap: 12px; padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px dashed rgba(255,255,255,.12); }
  .msg p { margin: 0; font-family: var(--font-sans); font-size: 16px; }
  .who { flex: none; color: var(--code-dim); font-size: 12.5px; padding-top: 3px; width: 48px; }
  .miss { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; color: var(--code-dim); }
  .miss li { display: flex; gap: 10px; align-items: center; }
  .miss span { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; border: 1px dashed var(--fail); color: #ff8a80; font-size: 12px; }
  .kv { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.07); }
  .kv span { color: var(--code-dim); }
  .kv code { overflow-wrap: anywhere; }
  .kv.hl code { color: var(--flash); }
  .todo { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .todo li { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; color: var(--code-dim); }
  .todo li::before { content: ''; width: 14px; height: 14px; border-radius: 4px; border: 1.5px solid rgba(255,255,255,.28); flex: none; }
  .todo li.ok { color: var(--code-ink); }
  .todo li.ok::before { background: var(--flash); border-color: var(--flash); }
  .todo li.now { color: var(--flash); }
  .todo li.now::before { border-color: var(--flash); }
  .todo em { font-style: normal; color: var(--code-dim); font-size: 12px; }
  .diffs { display: grid; gap: 8px; }
  .row { display: grid; grid-template-columns: 120px minmax(0, 1fr) auto auto; gap: 10px; align-items: center; padding: 10px 12px; border-radius: 8px; background: rgba(255,255,255,.04); }
  .row span { color: var(--code-dim); overflow-wrap: anywhere; }
  .row b { font-weight: 500; font-size: 11.5px; padding: 2px 6px; border-radius: 5px; }
  .fail { color: #ff8a80; background: rgba(255,138,128,.12); text-decoration: line-through; }
  .warn { color: #f2c14e; background: rgba(242,193,78,.12); text-decoration: line-through; }
  .fixed { color: #5cc98b; background: rgba(92,201,139,.12); }
  .rounds { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 18px; color: var(--code-dim); }
  .rounds .pass { color: #5cc98b; }
  .log { margin: 0; white-space: pre-wrap; font-size: 13.5px; line-height: 1.75; }
  .log .c { color: var(--code-dim); }
  .log b { color: var(--flash); font-weight: 500; }
  @media (max-width: 860px) {
    .stepper { grid-template-columns: minmax(0, 1fr); }
    .stage { position: static; min-height: 0; }
    .row { grid-template-columns: minmax(0, 1fr) auto auto; }
    .row span { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
