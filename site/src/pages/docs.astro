---
import Base from '../layouts/Base.astro';
import { readRepoFile, renderMarkdown, repoUrl } from '../lib/skills';

const readme = readRepoFile('README.md').replace(/\n## Table of Contents\n[\s\S]*?\n(?=## )/, '\n');
const { html, headings } = renderMarkdown(readme);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Base title="Docs — fstack" description="Install fstack, learn how the flash-mode router works, and browse every playbook, helper and principle." active="docs">
  <div class="wrap layout">
    <aside class="side">
      <nav aria-label="Docs contents">
        <p>Contents</p>
        <ul>
          {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.id}`}>{h.text}</a></li>)}
        </ul>
      </nav>
    </aside>
    <div>
      <div class="prose" set:html={html} />
      <p class="edit"><a href={`${repoUrl}/blob/main/README.md`}>Edit this page on GitHub</a></p>
    </div>
  </div>
</Base>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.side a'));
  const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const a = map.get(e.target.id);
      if (!a) continue;
      links.forEach((l) => l.removeAttribute('aria-current'));
      a.setAttribute('aria-current', 'true');
    }
  }, { rootMargin: '-80px 0px -70% 0px' });
  document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((h) => io.observe(h));
</script>

<style>
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(24px, 5vw, 72px); padding-top: clamp(32px, 5vw, 56px); padding-bottom: 40px; }
  .layout > div { max-width: 800px; min-width: 0; }
  .side { position: sticky; top: 80px; align-self: start; max-height: calc(100vh - 96px); overflow: auto; font-size: 14px; padding-bottom: 24px; }
  .side p { font: 500 12.5px var(--font-mono); color: var(--ink-3); margin: 0 0 10px; }
  .side ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .side a { display: block; padding: 4px 0 4px 14px; margin-left: -1px; border-left: 1px solid transparent; text-decoration: none; color: var(--ink-2); line-height: 1.35; }
  .side .d3 a { padding-left: 26px; font-size: 13.5px; color: var(--ink-3); }
  .side a:hover { color: var(--ink); }
  .side a[aria-current] { color: var(--ink); border-left-color: var(--flash-text); font-weight: 500; }
  .edit { margin-top: 48px; font-size: 14.5px; }
  .edit a { color: var(--ink-3); }
  @media (max-width: 900px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .side { display: none; }
  }
</style>
