---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import RouterDemo from '../components/RouterDemo.astro';
import Logo from '../components/Logo.astro';
import { getSkills, counts, pkg, repoUrl, groupLabels, titleOf, roles } from '../lib/skills';

const skills = getSkills();
const c = counts();
const bySlug = new Map(skills.map((s) => [s.slug, s]));
const name = (slug: string) => {
  const s = bySlug.get(slug)!;
  return s.type === 'helper' || s.type === 'router' ? `/${s.name}` : titleOf(s.name);
};

const agents = [
  { id: 'claude-code', name: 'Claude Code', path: '.claude/commands/fstack' },
  { id: 'cursor', name: 'Cursor', path: '.cursor/skills/fstack' },
  { id: 'codex', name: 'Codex', path: '.codex/skills/fstack' },
  { id: 'antigravity', name: 'Antigravity', path: '.antigravity/skills/fstack' },
  { id: 'opencode', name: 'OpenCode', path: '.opencode/skills/fstack' },
  { id: 'windsurf', name: 'Windsurf', path: '.windsurf/skills/fstack' },
  { id: 'copilot', name: 'Copilot', path: '.github/copilot/skills/fstack' },
];

const featured = ['figma-to-code', 'visual-parity', 'accessibility-audit'].map((s) => bySlug.get(s)!);
const floating = ['critique', 'a11y', 'unslop'].map((s) => bySlug.get(s)!);

// Small line icons (24px grid, stroke), one per group.
const icon: Record<string, string> = {
  design: '<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/>',
  frontend: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  shipping: '<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/>',
  session: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  advanced: '<path d="m12 2 10 5-10 5L2 7l10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>',
  helper: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
  principle: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  product: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9"/>',
  ux: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  ui: '<circle cx="13.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="13.5" r="2.5"/><circle cx="6.5" cy="12.5" r="2.5"/><path d="M12 22a10 10 0 1 1 10-10c0 2-1.5 3-3.5 3H17a2 2 0 0 0-1.5 3.3A2 2 0 0 1 14 22z"/>',
  frontendRole: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m8 10-2 2 2 2M16 10l2 2-2 2"/>',
};
const roleIcon: Record<string, string> = { product: icon.product, ux: icon.ux, ui: icon.ui, frontend: icon.frontendRole };

const columns = [
  { key: 'design', label: 'Design', items: skills.filter((s) => s.group === 'design') },
  { key: 'frontend', label: 'Frontend', items: skills.filter((s) => s.group === 'frontend') },
  { key: 'shipping', label: 'Shipping & session', items: skills.filter((s) => s.group === 'shipping' || s.group === 'session') },
  { key: 'advanced', label: 'Advanced', items: skills.filter((s) => s.group === 'advanced') },
  { key: 'principle', label: 'Principles', items: skills.filter((s) => s.type === 'principle') },
];
const helpers = skills.filter((s) => s.type === 'helper');

const faq = [
  { q: 'What is fstack?', a: `fstack is an open-source pack of ${c.total} agent skills for designers and frontend developers. Each skill is a SKILL.md file. One router, <code>/flash-mode</code>, matches your request to one of ${c.playbooks} playbooks and works it step by step.` },
  { q: 'How do I install it?', a: 'Run <code>npx fstack-skills init --platform claude-code</code> (or cursor, codex, antigravity, opencode, windsurf, copilot). Add <code>--global</code> to install for every project, or use <code>--platform all</code>.' },
  { q: 'Which agents does it work with?', a: 'Claude Code, Cursor, Codex, Antigravity, OpenCode, Windsurf and GitHub Copilot. SKILL.md is an open format, so any agent that reads skills can use fstack.' },
  { q: 'Do I need API keys or a paid service?', a: 'No. fstack is markdown and a small installer. It runs inside the agent you already use.' },
  { q: 'What does “sticky” mean?', a: 'After <code>/flash-mode</code>, follow-ups stay in the same playbook. Say <code>new task</code> to route a fresh request, or <code>exit</code> to leave.' },
  { q: 'How is it related to pstack?', a: 'fstack is modeled on <a href="https://flaviocopes.com/pstack/">pstack</a> by Lauren Tan, re-aimed at design and frontend work.' },
];
---
<Base active="home">
  <!-- Hero panel -->
  <section class="hero">
    <div class="sky" aria-hidden="true"></div>
    <div class="hero-inner">
      <a class="live" href="/skills"><span class="live-tag"><i></i>New</span>v{pkg.version} · {c.total} skills for design and frontend <span aria-hidden="true">→</span></a>
      <h1>Design skills to level up your agents.</h1>
      <p class="sub">Playbooks, helpers and principles for Claude Code, Cursor and Codex. Your agent picks the right workflow and proves the result on the real screen.</p>
      <div class="hero-actions">
        <a class="btn-white" href="#install">Install free <span aria-hidden="true">→</span></a>
        <a class="link-white" href="/skills">or browse all {c.total} skills</a>
      </div>

      <ul class="floaters" aria-label="Popular helpers">
        {floating.map((s, i) => (
          <li style={`--i:${i}`}><a href={`/skills/${s.slug}`}><span class="f-logo"><Logo size={18} /></span>/{s.name}<span class="f-meta">helper</span></a></li>
        ))}
      </ul>

      <p class="wordmark" aria-hidden="true">fstack</p>

      <div class="featured">
        <p class="featured-head"><span><i></i>Popular playbooks</span><a href="/skills?group=frontend">All {c.playbooks} <span aria-hidden="true">→</span></a></p>
        <ul>
          {featured.map((s, i) => (
            <li>
              <a href={`/skills/${s.slug}`}>
                <span class="cover" aria-hidden="true">
                  <span class="cover-n">#{i + 1}</span>
                  <span class="cover-steps">{s.body.match(/□ Step \d+: [^\n]+/g)?.slice(0, 4).map((l) => <span>□ {l.replace(/□ Step \d+: /, '')}</span>)}</span>
                </span>
                <span class="f-body">
                  <span class="f-by">{groupLabels[s.group]} playbook</span>
                  <span class="f-name">{s.name}</span>
                  <span class="f-desc">{s.short}</span>
                  <span class="f-foot"><span>{s.steps} steps</span><span class="f-tag">{groupLabels[s.group]}</span></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-sec">
    <div class="wrap">
      <dl class="stats">
        <div><dt>Agent skills</dt><dd>{c.total}</dd></div>
        <div><dt>Playbooks</dt><dd>{c.playbooks}</dd></div>
        <div><dt>Helpers</dt><dd>{c.helpers}</dd></div>
        <div><dt>Agents supported</dt><dd>{agents.length}</dd></div>
      </dl>
      <p class="works">Works in {agents.map((a, i) => <><b>{a.name}</b>{i < agents.length - 2 ? ', ' : i === agents.length - 2 ? ' and ' : ''}</>)}</p>
    </div>
  </section>

  <!-- Install -->
  <section class="sec" id="install">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Install</p>
        <h2 class="h2">One command. <span>Any agent.</span></h2>
        <p class="lede">Pick your agent and run the command in your project. No account, no API keys. Add <code>--global</code> to install for every project.</p>
        <div class="agent-tabs" role="tablist" aria-label="Choose your agent" data-agents>
          {agents.map((a, i) => (
            <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-id={a.id} data-path={a.path}>{a.name}</button>
          ))}
        </div>
      </div>
      <div class="term" data-term>
        <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>~/my-app</span></div>
        <div class="term-body">
          <CopyCommand cmd="npx fstack-skills init --platform claude-code" />
          <p class="out"><span class="ok">✓</span> {c.total} skills installed to <span data-path-out>.claude/commands/fstack</span></p>
          <p class="out"><span class="ok">✓</span> router <b>/flash-mode</b> ready</p>
          <p class="out dim">Try: /flash-mode implement this Figma design</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Router -->
  <section class="sec" id="how">
    <div class="wrap split">
      <div>
        <p class="eyebrow">The router</p>
        <h2 class="h2">Ask in plain words. <span>It picks the playbook.</span></h2>
        <p class="lede">Type <code>/flash-mode</code> and describe the task. It reads the principles, matches one of {c.playbooks} playbooks, copies the steps into a task list and won't call it done without evidence.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/skills/flash-mode">How flash-mode works <span aria-hidden="true">→</span></a>
          <a class="btn-ghost" href="/docs">Read the docs</a>
        </div>
      </div>
      <RouterDemo />
    </div>
  </section>

  <!-- Roles -->
  <section class="sec" id="roles">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="eyebrow">By role</p>
          <h2 class="h2">Skill sets for your role. <span>One router.</span></h2>
        </div>
        <a class="pill-link" href="/skills">All skills <span aria-hidden="true">→</span></a>
      </div>
      <ul class="roles">
        {roles.map((r) => (
          <li>
            <a href={`/skills?role=${r.id}`}>
              <span class="r-top">
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={roleIcon[r.id]} /></span>
                <span class="r-chips">{r.slugs.slice(0, 3).map((s) => <span>{name(s)}</span>)}</span>
              </span>
              <span class="r-title">{r.title}</span>
              <span class="r-blurb">{r.blurb}</span>
              <span class="r-foot"><span>For {r.label}</span><b>{r.slugs.length} skills</b></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bento -->
  <section class="sec" id="inside">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="eyebrow">What fstack does</p>
          <h2 class="h2">A design process for your agent. <span>In one install.</span></h2>
        </div>
      </div>
      <ul class="bento">
        <li class="b-card">
          <h3>Ask in plain words</h3>
          <p>Describe the task. The router finds the playbook that fits.</p>
          <div class="mock">
            <div class="m-search">make this button match Figma<i aria-hidden="true"></i></div>
            <ul class="m-results">
              <li><b>Visual Parity</b><span class="best">Best match</span></li>
              <li>Figma to Code<span>Frontend</span></li>
              <li>Design System<span>Design</span></li>
            </ul>
          </div>
        </li>
        <li class="b-card dark">
          <h3>Steps, not vibes</h3>
          <p>Every playbook is a checklist your agent works top to bottom.</p>
          <div class="mock m-progress">
            <p><b>Accessibility Audit</b><span>8 of 13</span></p>
            {['Automated checks', 'Keyboard navigation', 'Screen reader', 'Color and contrast'].map((t, i) => (
              <div class="bar"><span>{t}</span><i style={`--w:${[100, 100, 100, 62][i]}%`}></i></div>
            ))}
          </div>
        </li>
        <li class="b-card tint">
          <h3>Proof on the real screen</h3>
          <p>Nothing is done without a diff, an audit or a screenshot.</p>
          <div class="mock">
            <ul class="m-proof">
              <li><span class="x">×</span>“Done!”<span class="arrow">→</span><span class="v">✓</span>Screenshot attached</li>
              <li><span class="x">×</span>Default state only<span class="arrow">→</span><span class="v">✓</span>All states checked</li>
              <li><span class="x">×</span>Hard-coded values<span class="arrow">→</span><span class="v">✓</span>Design tokens</li>
            </ul>
          </div>
        </li>
        <li class="b-card">
          <h3>Logged for next time</h3>
          <p>Each task ends with a changelog entry your next session can read.</p>
          <div class="mock m-log">
            <p class="dim"># FSTACK_CHANGELOG.md</p>
            <p><b>Visual Parity · Primary button</b></p>
            <p>- Radius → --radius-md</p>
            <p>- Focus ring added</p>
            <p>- Evidence: diff 0 px</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Index -->
  <section class="sec" id="index">
    <div class="wrap">
      <div class="head-row">
        <div>
          <p class="eyebrow">Every skill</p>
          <h2 class="h2">A skill for every step. <span>{c.total} in total.</span></h2>
        </div>
        <a class="pill-link" href="/skills">Search all skills <span aria-hidden="true">→</span></a>
      </div>
      <div class="cols">
        {columns.map((col) => (
          <div class="col">
            <h3><span class="ico-sm" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon[col.key] || icon.session} /></span>{col.label}</h3>
            <ul>
              {col.items.map((s) => (
                <li><a href={`/skills/${s.slug}`} title={s.short}><span>{s.type === 'principle' ? s.name.replace(/-/g, ' ').replace(/^./, (ch) => ch.toUpperCase()) : titleOf(s.name)}</span>{s.steps > 0 && <em>{s.steps}</em>}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="helpers">
        <h3><span class="ico-sm" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon.helper} /></span>Helpers <span class="dim">commands you call directly</span></h3>
        <ul>{helpers.map((h) => <li><a href={`/skills/${h.slug}`} title={h.short}>/{h.name}</a></li>)}</ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="faq">
    <div class="wrap faq-grid">
      <h2 class="h2">fstack, <span>FAQs.</span></h2>
      <div class="faq">
        {faq.map((f, i) => (
          <details open={i === 0}><summary>{f.q}<span class="pm" aria-hidden="true"></span></summary><p set:html={f.a} /></details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final">
    <div class="sky" aria-hidden="true"></div>
    <div class="final-inner">
      <h2>Give your agent a process.<br /><span>Start in one command.</span></h2>
      <div class="final-cmd"><CopyCommand cmd="npx fstack-skills init --platform all" size="lg" /></div>
      <p>Free and MIT licensed. Built a skill? <a href={`${repoUrl}/issues`}>Suggest it for fstack</a>.</p>
    </div>
  </section>
</Base>

<script>
  // Agent tabs drive the terminal command and install path.
  const tabsRoot = document.querySelector<HTMLElement>('[data-agents]');
  const term = document.querySelector<HTMLElement>('[data-term]');
  if (tabsRoot && term) {
    const tabs = Array.from(tabsRoot.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const code = term.querySelector('.copycmd code');
    const btn = term.querySelector<HTMLButtonElement>('.copycmd button');
    const pathOut = term.querySelector('[data-path-out]');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, n) => { t.setAttribute('aria-selected', String(n === i)); t.tabIndex = n === i ? 0 : -1; });
      const cmd = `npx fstack-skills init --platform ${tabs[i].dataset.id}`;
      if (code?.lastChild) code.lastChild.textContent = cmd;
      if (btn) { btn.dataset.copy = cmd; btn.setAttribute('aria-label', `Copy command: ${cmd}`); }
      if (pathOut) pathOut.textContent = tabs[i].dataset.path || '';
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          select((i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, true);
        }
      });
    });
  }
</script>

<style>
  /* ---------- Sky panel (hero + final CTA) ---------- */
  .sky {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse 40% 35% at 82% 22%, rgba(255, 255, 255, .20), transparent 70%),
      radial-gradient(ellipse 55% 40% at 72% 88%, rgba(255, 255, 255, .16), transparent 70%),
      radial-gradient(ellipse 30% 25% at 12% 92%, rgba(255, 255, 255, .10), transparent 70%),
      linear-gradient(160deg, #123f73 0%, #1d5a9c 45%, #3374b8 80%, #4a88c8 100%);
  }
  .sky::after {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, .16) 1px, transparent 1.4px);
    background-size: 6px 6px;
    -webkit-mask-image: linear-gradient(110deg, transparent 35%, #000 70%);
    mask-image: linear-gradient(110deg, transparent 35%, #000 70%);
  }
  :global(:root[data-theme='dark']) .sky { filter: brightness(.55) saturate(1.1); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .sky { filter: brightness(.55) saturate(1.1); } }

  /* ---------- Hero ---------- */
  .hero { position: relative; isolation: isolate; overflow: hidden; margin: -64px 8px 0; border-radius: 22px; min-height: max(760px, 100svh - 16px); color: #fff; }
  .hero-inner { position: relative; max-width: 1440px; margin: 0 auto; padding: 128px clamp(20px, 4vw, 58px) 28px; min-height: inherit; display: flex; flex-direction: column; }
  .live { align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; height: 34px; padding: 0 12px 0 4px; border-radius: 999px; background: rgba(255, 255, 255, .88); color: #02070a; text-decoration: none; font-size: 14.5px; font-weight: 500; }
  .live-tag { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border-radius: 999px; background: #02070a; color: #fff; font-size: 13px; }
  .live-tag i { width: 6px; height: 6px; border-radius: 50%; background: #3ddc84; }
  h1 { font-size: clamp(42px, 5.6vw, 76px); font-weight: 500; letter-spacing: -0.045em; line-height: 1.02; margin: 22px 0 18px; max-width: 15ch; text-wrap: balance; }
  .sub { font-size: clamp(17px, 1.6vw, 21px); line-height: 1.5; max-width: 32em; margin: 0; color: rgba(255, 255, 255, .9); }
  .hero-actions { display: flex; align-items: center; gap: 20px; margin-top: 30px; flex-wrap: wrap; }
  .btn-white { display: inline-flex; align-items: center; gap: 10px; height: 52px; padding: 0 24px; border-radius: 999px; background: #fff; color: #02070a; text-decoration: none; font-size: 16px; font-weight: 500; transition: transform .15s; }
  .btn-white:hover { transform: translateY(-1px); }
  .link-white { color: rgba(255, 255, 255, .9); font-size: 15.5px; text-underline-offset: 4px; }

  .floaters { list-style: none; margin: 0; padding: 0; position: absolute; right: clamp(20px, 6vw, 96px); top: 300px; width: 340px; height: 160px; }
  .floaters li { position: absolute; animation: float 7s ease-in-out infinite; animation-delay: calc(var(--i) * -2.2s); }
  .floaters li:nth-child(1) { right: 0; top: 0; }
  .floaters li:nth-child(2) { left: 0; top: 56px; }
  .floaters li:nth-child(3) { right: 40px; top: 116px; }
  .floaters a { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 14px 0 6px; border-radius: 999px; background: rgba(255, 255, 255, .78); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); color: #02070a; text-decoration: none; font: 500 15px var(--font-mono); box-shadow: 0 6px 20px -8px rgba(2, 7, 10, .3); transition: transform .2s; }
  .floaters a:hover { transform: scale(1.04); }
  .f-logo { display: grid; place-items: center; }
  .f-meta { font: 12.5px var(--font-sans); color: #646d74; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  .wordmark { position: absolute; left: clamp(20px, 4vw, 58px); bottom: -0.16em; margin: 0; font-size: clamp(110px, 14.5vw, 220px); font-weight: 500; letter-spacing: -0.07em; line-height: 1; color: #fff; user-select: none; }

  .featured { position: absolute; right: clamp(12px, 1.5vw, 20px); bottom: 20px; width: min(760px, 58%); }
  .hero .sky { box-shadow: inset 0 -380px 260px -160px rgba(6, 24, 48, .38); }
  .featured-head { display: flex; justify-content: space-between; align-items: center; margin: 0 8px 12px; font-size: 15px; }
  .featured-head > span, .featured-head > a { display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 12px; border-radius: 999px; background: rgba(2, 7, 10, .32); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .featured-head i { width: 7px; height: 7px; border-radius: 50%; background: var(--flash); }
  .featured-head a { color: #fff; text-decoration: none; white-space: nowrap; }
  .featured-head a:hover { color: #fff; }
  .featured ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .featured ul a { display: flex; flex-direction: column; height: 100%; padding: 6px; border-radius: 16px; background: rgba(255, 255, 255, .9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); color: #02070a; text-decoration: none; transition: transform .2s; }
  .featured ul a:hover { transform: translateY(-3px); }
  .cover { position: relative; display: block; height: 104px; border-radius: 11px; background: #02070a; color: #e9edf0; padding: 10px 12px; overflow: hidden; }
