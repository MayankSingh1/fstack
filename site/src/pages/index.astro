---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import RouterDemo from '../components/RouterDemo.astro';
import VerifiedStepper from '../components/VerifiedStepper.astro';
import InstallTabs from '../components/InstallTabs.astro';
import { getSkills, counts, pkg, repoUrl, groupLabels, titleOf } from '../lib/skills';

const skills = getSkills();
const c = counts();
const boardGroups = ['design', 'frontend', 'shipping', 'session', 'advanced'];
const board = boardGroups.map((g) => ({ g, items: skills.filter((s) => s.type === 'playbook' && s.group === g) }));
let n = 0;
const principles = skills.filter((s) => s.type === 'principle');
const agents = ['Claude Code', 'Cursor', 'Codex', 'Antigravity', 'OpenCode', 'Windsurf', 'GitHub Copilot'];

const audience = [
  { who: 'Product designers', what: 'Frame the problem, map flows and IA, take wireframes to hi-fi.', ask: 'research why users abandon the checkout flow' },
  { who: 'UX designers', what: 'Write copy that helps, design every state, critique with several reviewers.', ask: 'write the error messages for this form' },
  { who: 'UI designers', what: 'Build tokens and a design system that code actually uses.', ask: 'create tokens for our color system' },
  { who: 'Frontend developers', what: 'Figma to code, pixel parity, accessibility and responsive checks, then a PR.', ask: 'implement this Figma design for the dashboard header' },
];

const faq = [
  { q: 'Which agents does it work with?', a: 'Claude Code, Cursor, Codex, Antigravity, OpenCode, Windsurf and GitHub Copilot. Skills are plain SKILL.md files, so any agent that reads them can use fstack. <code>--platform all</code> installs into every agent it detects.' },
  { q: 'Do I need API keys or a paid service?', a: 'No. fstack is markdown and a small installer. It runs inside the agent you already pay for, with the tools that agent already has.' },
  { q: 'What does “sticky” mean?', a: 'After <code>/flash-mode</code>, follow-up messages stay in the same playbook. Say <code>new task</code> to route a fresh request, or <code>exit</code> to leave.' },
  { q: 'Can I use one skill without the router?', a: 'Yes. Helpers are direct commands: <code>/a11y check this form</code>, <code>/critique review this component</code>, <code>/unslop clean up this PR description</code>.' },
  { q: 'Can different models handle different work?', a: 'Run <code>/setup-fstack</code> to pick a model per role: investigation, implementation, judgment, review and prose. The router delegates by role when it is configured.' },
  { q: 'How do I update or remove it?', a: 'Run <code>npx fstack-skills@latest init</code> again to update. <code>fstack uninstall</code> removes it, and <code>fstack status</code> shows where it is installed.' },
  { q: 'How is it related to pstack?', a: 'fstack is modeled on <a href="https://flaviocopes.com/pstack/">pstack</a> by Lauren Tan and re-aimed at design and frontend work: Figma, tokens, accessibility, visual parity and UX copy.' },
];
---
<Base active="home">
  <section class="hero">
    <div class="wrap">
      <a class="pill" href="/skills"><span class="dot" aria-hidden="true"></span>v{pkg.version} · {c.total} skills for design and frontend work</a>
      <h1>The design &amp; frontend <span class="mark">workflow</span> for AI coding agents</h1>
      <p class="lede">One command reads what you asked for, picks the right playbook from {c.playbooks}, works it step by step, and won't call the job done until it can show you the screenshot.</p>
      <div class="cta">
        <CopyCommand cmd="npx fstack-skills init --platform claude-code" size="lg" />
        <a class="btn btn-secondary" href="/docs">Read the docs</a>
      </div>
      <ul class="agents" aria-label="Works with">
        {agents.map((a) => <li>{a}</li>)}
      </ul>
      <div class="hero-demo"><RouterDemo /></div>
    </div>
  </section>

  <section class="block board-sec" id="playbooks">
    <div class="wrap">
      <p class="eyebrow">{c.playbooks} playbooks</p>
      <h2 class="h-section">You describe the task.<br />flash-mode picks the playbook.</h2>
      <p class="lede">Each playbook is a checklist with an evidence rule and a changelog entry at the end. Hover one to see what it does.</p>
      <div class="board">
        {board.map(({ g, items }) => (
          <div class="col">
            <h3>{groupLabels[g]}</h3>
            <ol>
              {items.map((s) => {
                n++;
                return (
                  <li>
                    <a href={`/skills/${s.slug}`}>
                      <span class="idx">{String(n).padStart(2, '0')}</span>
                      <span class="nm">{titleOf(s.name)}</span>
                      <span class="ds">{s.short}</span>
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
      </div>
      <a class="more" href="/skills">Browse all {c.total} skills →</a>
    </div>
  </section>

  <section class="block how" id="how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 class="h-section">A design process, packaged as skills.</h2>
      <p class="lede">One install gives your agent a router, {c.playbooks} playbooks, {c.helpers} helpers and {c.principles} principles. Everything is plain markdown you can read and change.</p>

      <div class="cards">
        <article class="card">
          <div class="viz transcript" aria-hidden="true">
            <p><span class="u">you</span><code>/flash-mode fix the modal that won't close</code></p>
            <p class="sys"><span class="u">fstack</span>Bug Fix · step 1 of 13</p>
            <p><span class="u">you</span><code>also check it on mobile</code></p>
            <p class="sys"><span class="u">fstack</span>still Bug Fix · step 6 of 13</p>
            <p><span class="u">you</span><code>new task</code></p>
            <p class="sys"><span class="u">fstack</span>routing a fresh request…</p>
          </div>
          <p class="tag">Router</p>
          <h3>Stays on the job</h3>
          <p>flash-mode is sticky. Follow-ups stay in the same playbook until you say <code>new task</code> or <code>exit</code>, so context never drifts.</p>
          <code class="file">skills/flash-mode/SKILL.md</code>
        </article>

        <article class="card">
          <div class="viz checks" aria-hidden="true">
            <div><code>contrast</code><span>placeholder 3.1:1</span><b class="f">FAIL</b><b class="ok">Fixed</b></div>
            <div><code>keyboard</code><span>trap in date picker</span><b class="f">FAIL</b><b class="ok">Fixed</b></div>
            <div><code>390px</code><span>CTA wraps to 3 lines</span><b class="w">WARN</b><b class="ok">Fixed</b></div>
            <div><code>states</code><span>no empty state</span><b class="w">WARN</b><b class="ok">Fixed</b></div>
            <p class="round"><span>Pass 1 · 2 FAIL, 2 WARN</span><span class="ok">Pass 2 · clean</span></p>
          </div>
          <p class="tag">Evidence</p>
          <h3>No proof, no “done”</h3>
          <p>Every playbook ends with an evidence rule: a 0 px diff, a passed audit, a screenshot on the real screen. The router refuses to report success without it.</p>
          <code class="file">principles/prove-on-real-screen</code>
        </article>

        <article class="card">
          <div class="viz principles" aria-hidden="true">
            {principles.map((p, i) => <span class="chip" style={`--i:${i}`}>{p.name}</span>)}
          </div>
          <p class="tag">Principles</p>
          <h3>Guardrails that apply themselves</h3>
          <p>{c.principles} principles, like <em>tokens over hard-coded values</em> and <em>states are design</em>, are read before every task and applied where they fit.</p>
          <code class="file">skills/flash-mode/principles-index.md</code>
        </article>
      </div>
    </div>
  </section>

  <section class="block" id="verified">
    <div class="wrap">
      <p class="eyebrow">Before and after</p>
      <h2 class="h-section">From vibe-coded to verified.</h2>
      <p class="lede">Same request, “make this button match the Figma design”. Step through what changes when fstack is installed.</p>
      <div class="stepper-wrap"><VerifiedStepper /></div>
    </div>
  </section>

  <section class="block for" id="for">
    <div class="wrap">
      <p class="eyebrow">Who it's for</p>
      <h2 class="h-section">Built for the people who care how it looks and works.</h2>
      <div class="aud">
        {audience.map((a) => (
          <article>
            <h3>{a.who}</h3>
            <p>{a.what}</p>
            <code><b>/flash-mode</b> {a.ask}</code>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="install">
    <div class="wrap install-grid">
      <div>
        <p class="eyebrow">Install</p>
        <h2 class="h-section">Works in the agent you already use.</h2>
        <p class="lede">One command, no API keys, nothing running in the background. Needs Node 16 or newer.</p>
        <ol class="quick">
          <li><span>1</span>Install for your agent</li>
          <li><span>2</span>Optional: <code>/setup-fstack</code> to pick models per role</li>
          <li><span>3</span>Ask: <code>/flash-mode implement this Figma design</code></li>
        </ol>
      </div>
      <InstallTabs />
    </div>
  </section>

  <section class="block faq-sec" id="faq">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 class="h-section">Common questions.</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p set:html={f.a} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="block oss">
    <div class="wrap">
      <div class="oss-card">
        <div>
          <p class="eyebrow">Open source</p>
          <h2 class="h-section">Free, MIT, and yours to fork.</h2>
          <p class="lede">Every skill is a markdown file you can read, edit or replace. Found a gap? Write a playbook with <code>authoring-a-skill</code> and open a PR.</p>
        </div>
        <div class="oss-actions">
          <a class="btn btn-primary" href={repoUrl}>Star on GitHub</a>
          <a class="btn btn-secondary" href={`${repoUrl}/issues`}>Request a skill</a>
        </div>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="wrap">
      <h2>Stop prompting.<br /><span class="mark">Start shipping.</span></h2>
      <div class="closing-cmd"><CopyCommand cmd="npx fstack-skills init --platform all --global" size="lg" /></div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 80px); }
  .pill { display: inline-flex; align-items: center; gap: 9px; height: 32px; padding: 0 14px 0 12px; border-radius: 999px; background: var(--bg-raised); box-shadow: var(--shadow); text-decoration: none; font-size: 14px; color: var(--ink-2); }
  .pill:hover { color: var(--ink); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--flash); box-shadow: 0 0 0 3px color-mix(in srgb, var(--flash) 30%, transparent); }
  h1 { font-size: clamp(44px, 8.4vw, 100px); line-height: 0.96; letter-spacing: -0.045em; font-weight: 600; margin: 26px 0 24px; max-width: 13ch; text-wrap: balance; }
  .hero .lede { font-size: clamp(18px, 1.9vw, 21px); max-width: 34em; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-top: 32px; }
  .cta .copycmd { flex: 0 1 470px; }
  .agents { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 8px 22px; font: 500 14px var(--font-mono); color: var(--ink-3); }
  .agents li::before { content: '✓'; color: var(--flash-text); margin-right: 6px; }
  .hero-demo { margin-top: clamp(48px, 7vw, 80px); }

  .board { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 28px 20px; margin-top: 48px; }
  .col h3 { font: 500 13px var(--font-mono); color: var(--ink-3); margin: 0 0 10px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .col ol { list-style: none; margin: 0; padding: 0; }
  .col a { display: grid; grid-template-columns: 28px minmax(0, 1fr); padding: 9px 8px; margin: 0 -8px; border-radius: 9px; text-decoration: none; }
  .idx { font: 12px var(--font-mono); color: var(--ink-3); padding-top: 3px; }
  .nm { font-weight: 500; font-size: 15.5px; }
  .ds { grid-column: 2; font-size: 13.5px; color: var(--ink-3); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-height: 0; opacity: 0; transition: max-height .25s ease, opacity .2s ease, margin .2s; }
  .col a:hover, .col a:focus-visible { background: var(--bg-raised); box-shadow: var(--shadow); }
  .col a:hover .ds, .col a:focus-visible .ds { max-height: 3em; opacity: 1; margin-top: 3px; }
  .col a:hover .idx { color: var(--flash-text); }
  @media (hover: none) { .ds { max-height: 3em; opacity: 1; margin-top: 2px; } }
  .more { display: inline-block; margin-top: 36px; font-weight: 500; color: var(--flash-text); text-underline-offset: 4px; }
  @media (max-width: 1060px) { .board { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .board { grid-template-columns: minmax(0, 1fr); } }

  .how { background: var(--bg-sunk); }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 48px; }
  .card { background: var(--bg-raised); border-radius: var(--radius-lg); box-shadow: var(--shadow); padding: 14px 14px 24px; display: flex; flex-direction: column; }
  .card > :not(.viz) { margin-left: 10px; margin-right: 10px; }
  .card h3 { font-size: 21px; letter-spacing: -0.015em; margin: 4px 0 8px; font-weight: 600; }
  .card p { color: var(--ink-2); font-size: 15.5px; margin-top: 0; margin-bottom: 16px; }
  .card > p code, .lede code, .quick code { font-size: .86em; background: var(--bg-sunk); padding: 1px 5px; border-radius: 5px; }
  .card .tag { font: 500 12.5px var(--font-mono); color: var(--flash-text); margin: 20px 10px 0; }
  .card .file { margin-top: auto; font-size: 12.5px; color: var(--ink-3); }
  .viz { background: var(--code-bg); color: var(--code-ink); border-radius: 12px; padding: 16px; font: 12.5px/1.5 var(--font-mono); min-height: 252px; }
  .transcript p { display: flex; gap: 10px; margin: 0 0 9px; color: var(--code-ink); font-size: 12.5px; }
  .transcript .u { flex: none; width: 44px; color: var(--code-dim); }
  .transcript .sys { color: var(--flash); }
  .checks > div { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto auto; gap: 8px; align-items: center; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,.07); }
  .checks span { color: var(--code-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .checks b { font-weight: 500; font-size: 10.5px; padding: 1px 5px; border-radius: 4px; }
  .checks .f { color: #ff8a80; background: rgba(255,138,128,.12); text-decoration: line-through; }
  .checks .w { color: #f2c14e; background: rgba(242,193,78,.12); text-decoration: line-through; }
  .checks .ok { color: #5cc98b; }
  .checks b.ok { background: rgba(92,201,139,.12); }
  .checks .round { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin: 14px 0 0; color: var(--code-dim); font-size: 12px; }
  .principles { display: flex; flex-wrap: wrap; align-content: center; gap: 8px; }
  .principles .chip { border-color: rgba(255,255,255,.18); color: var(--code-ink); height: 30px; animation: glow 7s ease infinite; animation-delay: calc(var(--i) * 1s); }
  @keyframes glow { 0%, 10%, 100% { background: transparent; color: var(--code-ink); border-color: rgba(255,255,255,.18); } 3%, 8% { background: var(--flash); color: var(--code-bg); border-color: var(--flash); } }
  @media (prefers-reduced-motion: reduce) { .principles .chip { animation: none; } }
  @media (max-width: 980px) { .cards { grid-template-columns: 1fr; max-width: 560px; } }

  .stepper-wrap { margin-top: 48px; }

  .aud { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 44px; }
  .aud article { border-top: 2px solid var(--ink); padding-top: 18px; display: flex; flex-direction: column; }
  .aud h3 { font-size: 19px; margin: 0 0 8px; font-weight: 600; letter-spacing: -0.01em; }
  .aud p { color: var(--ink-2); font-size: 15.5px; margin: 0 0 16px; }
  .aud code { margin-top: auto; font-size: 12.5px; background: var(--bg-raised); box-shadow: var(--shadow); padding: 10px 12px; border-radius: 9px; color: var(--ink-2); line-height: 1.5; }
  .aud code b { color: var(--flash-text); font-weight: 500; }
  @media (max-width: 980px) { .aud { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .aud { grid-template-columns: 1fr; } }

  .install-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .quick { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 12px; color: var(--ink-2); }
  .quick li { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .quick span { width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; font: 500 12px var(--font-mono); background: var(--ink); color: var(--bg); flex: none; }
  @media (max-width: 900px) { .install-grid { grid-template-columns: minmax(0, 1fr); } }

  .faq-sec { border-top: 1px solid var(--line); }
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(24px, 5vw, 64px); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq details:first-child { border-top: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; padding: 20px 36px 20px 0; font-size: 18px; font-weight: 500; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 4px; top: 16px; font: 400 24px var(--font-mono); color: var(--ink-3); transition: transform .2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq p { margin: -6px 0 22px; color: var(--ink-2); max-width: 40em; }
  .faq :global(code) { font-size: .86em; background: var(--bg-sunk); padding: 1px 5px; border-radius: 5px; }
  .faq :global(a) { color: var(--flash-text); }
  @media (max-width: 820px) { .faq-grid { grid-template-columns: minmax(0, 1fr); } }

  .oss { padding-top: 0; }
  .oss-card { background: var(--ink); color: var(--bg); border-radius: 24px; padding: clamp(28px, 6vw, 64px); display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .oss-card .eyebrow { color: color-mix(in srgb, var(--bg) 60%, transparent); }
  .oss-card .lede { color: color-mix(in srgb, var(--bg) 75%, transparent); }
  .oss-card .lede code { background: color-mix(in srgb, var(--bg) 14%, transparent); }
  .oss-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .oss-card .btn-primary { background: var(--flash); color: var(--flash-ink); }
  .oss-card .btn-secondary { background: transparent; color: var(--bg); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--bg) 30%, transparent); }

  .closing { padding: clamp(40px, 8vw, 100px) 0 clamp(40px, 6vw, 72px); text-align: center; }
  .closing h2 { font-size: clamp(48px, 10vw, 128px); line-height: 0.95; letter-spacing: -0.05em; font-weight: 600; margin: 0 0 40px; }
  .closing-cmd { display: flex; justify-content: center; }
  .closing-cmd :global(.copycmd) { width: min(520px, 100%); text-align: left; }
</style>
