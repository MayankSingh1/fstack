---
import Base from '../layouts/Base.astro';
import CopyCommand from '../components/CopyCommand.astro';
import RouterDemo from '../components/RouterDemo.astro';
import { getSkills, counts, pkg, repoUrl, groupLabels, titleOf } from '../lib/skills';

const skills = getSkills();
const c = counts();

const agents = [
  { id: 'claude-code', name: 'Claude Code', path: '.claude/commands/fstack' },
  { id: 'cursor', name: 'Cursor', path: '.cursor/skills/fstack' },
  { id: 'codex', name: 'Codex', path: '.codex/skills/fstack' },
  { id: 'antigravity', name: 'Antigravity', path: '.antigravity/skills/fstack' },
  { id: 'opencode', name: 'OpenCode', path: '.opencode/skills/fstack' },
  { id: 'windsurf', name: 'Windsurf', path: '.windsurf/skills/fstack' },
  { id: 'copilot', name: 'Copilot', path: '.github/copilot/skills/fstack' },
];

const roles = [
  { id: 'product', label: 'Product designer', slugs: ['problem-framing', 'user-flows-ia', 'wireframe-to-hifi', 'design-critique', 'prototype', 'handoff-note', 'critique'] },
  { id: 'ux', label: 'UX designer', slugs: ['ux-copy', 'user-flows-ia', 'design-critique', 'critique', 'a11y', 'unslop', 'states-are-design'] },
  { id: 'ui', label: 'UI designer', slugs: ['design-system', 'wireframe-to-hifi', 'visual-parity', 'figma-to-code', 'tokens-over-hardcoded', 'design-system-consistency', 'why-this-design'] },
  { id: 'frontend', label: 'Frontend developer', slugs: ['figma-to-code', 'visual-parity', 'accessibility-audit', 'responsive-cross-browser', 'component-refactor', 'bug-fix', 'open-pr', 'tdd'] },
];
const rolesOf = (slug: string) => roles.filter((r) => r.slugs.includes(slug)).map((r) => r.id).join(' ');

const typeFilters = [
  { id: 'all', label: 'All', n: c.total },
  { id: 'playbook', label: 'Playbooks', n: c.playbooks },
  { id: 'helper', label: 'Helpers', n: c.helpers },
  { id: 'principle', label: 'Principles', n: c.principles },
];
const typeLabel = { router: 'Router', playbook: 'Playbook', helper: 'Helper', principle: 'Principle' } as const;

const steps = [
  { n: '01', t: 'Ask', d: 'Type /flash-mode and describe the task in plain words.' },
  { n: '02', t: 'Follow the playbook', d: `It picks one of ${c.playbooks} playbooks and copies the steps into a task list.` },
  { n: '03', t: 'Prove and log', d: 'Nothing is done without evidence: a diff, an audit or a screenshot, then a changelog entry.' },
];

const compare = [
  ['Which Figma frame?', 'Source of truth identified first'],
  ['Looks about right', 'Pixel diff before and after'],
  ['Default state only', 'Hover, focus and disabled checked'],
  ['Hard-coded values', 'Design tokens'],
  ['“Done!”', 'Screenshot attached as evidence'],
  ['Forgotten next session', 'Logged in the changelog'],
];

const faq = [
  { q: 'Which agents does it work with?', a: 'Claude Code, Cursor, Codex, Antigravity, OpenCode, Windsurf and GitHub Copilot. Skills are plain SKILL.md files, so any agent that reads them can use fstack. <code>--platform all</code> installs into every agent it detects.' },
  { q: 'Do I need API keys or a paid service?', a: 'No. fstack is markdown and a small installer. It runs inside the agent you already use.' },
  { q: 'What does “sticky” mean?', a: 'After <code>/flash-mode</code>, follow-ups stay in the same playbook. Say <code>new task</code> to route a fresh request, or <code>exit</code> to leave.' },
  { q: 'Can I use one skill without the router?', a: 'Yes. Helpers are direct commands, like <code>/a11y check this form</code> or <code>/critique review this component</code>.' },
  { q: 'How do I update or remove it?', a: 'Run <code>npx fstack-skills@latest init</code> again to update. <code>fstack uninstall</code> removes it.' },
  { q: 'How is it related to pstack?', a: 'fstack is modeled on <a href="https://flaviocopes.com/pstack/">pstack</a> by Lauren Tan, re-aimed at design and frontend work.' },
];
---
<Base active="home">
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="tag"><span class="dot" aria-hidden="true"></span>v{pkg.version} · open source · MIT</p>
        <h1>Design and frontend skills for AI coding agents.</h1>
        <p class="lede">{c.total} skills that make your agent work like a careful designer-developer: pick the right playbook, follow every step, and <mark>prove it on the real screen</mark>.</p>
        <div class="hero-links">
          <a class="btn btn-primary" href="#skills">Explore the skills</a>
          <a class="btn btn-secondary" href="/docs">Read the docs</a>
        </div>
      </div>

      <div class="install-card" id="install" data-install>
        <p class="card-label">Install for</p>
        <div class="agent-tabs" role="tablist" aria-label="Choose your agent">
          {agents.map((a, i) => (
            <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-id={a.id} data-path={a.path}>{a.name}</button>
          ))}
        </div>
        <div role="tabpanel" aria-live="polite">
          <CopyCommand cmd="npx fstack-skills init --platform claude-code" />
          <p class="path">Installs to <code data-path-out>.claude/commands/fstack</code>. Add <code>--global</code> for every project.</p>
        </div>
        <p class="then">Then ask: <code>/flash-mode implement this Figma design</code></p>
      </div>
    </div>

    <div class="wrap">
      <ul class="stats">
        <li><b>1</b>router</li>
        <li><b>{c.playbooks}</b>playbooks</li>
        <li><b>{c.helpers}</b>helpers</li>
        <li><b>{c.principles}</b>principles</li>
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="sec" id="how">
    <div class="wrap row">
      <header class="label"><h2>How it works</h2><p>One command routes every request.</p></header>
      <div class="content">
        <ol class="steps">
          {steps.map((s) => (
            <li><span class="n">{s.n}</span><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ol>
        <div class="demo"><RouterDemo /></div>
      </div>
    </div>
  </section>

  <!-- Compare -->
  <section class="sec" id="compare">
    <div class="wrap row">
      <header class="label"><h2>Why it helps</h2><p>Same request: “make this button match the Figma design”.</p></header>
      <div class="content">
        <div class="compare" role="table" aria-label="Without and with fstack">
          <div class="c-head" role="row"><span role="columnheader">Without fstack</span><span role="columnheader">With fstack</span></div>
          {compare.map(([a, b]) => (
            <div class="c-row" role="row"><span role="cell" class="no">{a}</span><span role="cell" class="yes">{b}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Skills explorer -->
  <section class="sec" id="skills">
    <div class="wrap row">
      <header class="label">
        <h2>All {c.total} skills</h2>
        <p>Filter by your role or by kind. Every card opens the full skill.</p>
      </header>
      <div class="content" data-explorer>
        <div class="filters">
          <div class="frow" role="group" aria-label="I am a">
            <span class="flabel">I'm a</span>
            {roles.map((r) => <button type="button" class="fchip" data-role={r.id} aria-pressed="false">{r.label}</button>)}
          </div>
          <div class="frow" role="group" aria-label="Show">
            <span class="flabel">Show</span>
            {typeFilters.map((t, i) => <button type="button" class="fchip" data-type={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label} <span>{t.n}</span></button>)}
          </div>
          <label class="search">
            <span class="sr-only">Search skills</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" placeholder="Search figma, a11y, PR, tokens…" autocomplete="off" data-q />
          </label>
        </div>
        <p class="count" aria-live="polite"><b data-count>{c.total}</b> skills</p>
        <ul class="grid">
          {skills.map((s) => (
            <li data-type={s.type} data-roles={rolesOf(s.slug)} data-text={`${s.name} ${s.description} ${s.group}`.toLowerCase()}>
              <a href={`/skills/${s.slug}`}>
                <span class="meta"><span class={`badge b-${s.type}`}>{typeLabel[s.type]}</span>{s.type === 'playbook' && <span>{groupLabels[s.group]}</span>}</span>
                <span class="nm">{s.type === 'helper' || s.type === 'router' ? `/${s.name}` : titleOf(s.name)}</span>
                <span class="ds">{s.short}</span>
              </a>
            </li>
          ))}
        </ul>
        <button type="button" class="more" data-more>Show all {c.total} skills</button>
        <p class="empty" hidden data-empty>No skills match. <button type="button" data-reset>Clear filters</button></p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec" id="faq">
    <div class="wrap row">
      <header class="label"><h2>Questions</h2></header>
      <div class="content faq">
        {faq.map((f) => (
          <details><summary>{f.q}</summary><p set:html={f.a} /></details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-sec">
    <div class="wrap">
      <div class="cta">
        <div>
          <h2>Give your agent a process.</h2>
          <p>Free and MIT licensed. Every skill is a markdown file you can read and change.</p>
        </div>
        <div class="cta-actions">
          <CopyCommand cmd="npx fstack-skills init --platform all" />
          <a class="btn btn-secondary" href={repoUrl}>View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Hero install: agent tabs update the command and path.
  document.querySelectorAll<HTMLElement>('[data-install]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role=tab]'));
    const code = root.querySelector('.copycmd code');
    const btn = root.querySelector<HTMLButtonElement>('.copycmd button');
    const pathOut = root.querySelector('[data-path-out]');
    const select = (i: number, focus = false) => {
      tabs.forEach((t, n) => { t.setAttribute('aria-selected', String(n === i)); t.tabIndex = n === i ? 0 : -1; });
      const cmd = `npx fstack-skills init --platform ${tabs[i].dataset.id}`;
      if (code) code.lastChild!.textContent = cmd;
      if (btn) { btn.dataset.copy = cmd; btn.setAttribute('aria-label', `Copy command: ${cmd}`); }
      if (pathOut) pathOut.textContent = tabs[i].dataset.path || '';
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          select((i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length, true);
        }
      });
    });
  });

  // Skills explorer: role, type and text filters combine.
  const ex = document.querySelector<HTMLElement>('[data-explorer]');
  if (ex) {
    const items = Array.from(ex.querySelectorAll<HTMLLIElement>('.grid li'));
    const roleBtns = Array.from(ex.querySelectorAll<HTMLButtonElement>('[data-role]'));
    const typeBtns = Array.from(ex.querySelectorAll<HTMLButtonElement>('[data-type]'));
    const q = ex.querySelector<HTMLInputElement>('[data-q]')!;
    const count = ex.querySelector('[data-count]')!;
    const empty = ex.querySelector<HTMLElement>('[data-empty]')!;
    const more = ex.querySelector<HTMLButtonElement>('[data-more]')!;
    const PREVIEW = 12;
    let role = '', type = 'all', expanded = false;
    const apply = () => {
      const terms = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const filtered = !!role || type !== 'all' || terms.length > 0;
      let n = 0;
      items.forEach((li) => {
        const ok = (!role || (li.dataset.roles || '').split(' ').includes(role))
          && (type === 'all' || li.dataset.type === type)
          && terms.every((t) => li.dataset.text!.includes(t));
        if (ok) n++;
        li.hidden = !ok || (!filtered && !expanded && n > PREVIEW);
      });
      count.textContent = String(n);
      empty.hidden = n !== 0;
      more.hidden = filtered || expanded;
    };
    more.addEventListener('click', () => {
      expanded = true; apply();
      items[PREVIEW]?.querySelector('a')?.focus();
    });
    apply();
    roleBtns.forEach((b) => b.addEventListener('click', () => {
      role = role === b.dataset.role ? '' : b.dataset.role!;
      roleBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.role === role)));
      apply();
    }));
    typeBtns.forEach((b) => b.addEventListener('click', () => {
      type = b.dataset.type!;
      typeBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    q.addEventListener('input', apply);
    ex.querySelector('[data-reset]')!.addEventListener('click', () => {
      role = ''; type = 'all'; q.value = '';
      roleBtns.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      typeBtns.forEach((x, i) => x.setAttribute('aria-pressed', String(i === 0)));
      apply(); q.focus();
    });
  }
</script>

<style>
  mark { background: none; color: inherit; text-decoration: underline; text-decoration-color: var(--flash); text-decoration-thickness: .16em; text-underline-offset: .18em; text-decoration-skip-ink: none; }

  /* Hero */
  .hero { padding: clamp(48px, 8vw, 96px) 0 0; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .tag { display: inline-flex; align-items: center; gap: 8px; font: 13px var(--font-mono); color: var(--ink-3); margin: 0 0 20px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--flash); }
  h1 { font-size: clamp(38px, 5.4vw, 60px); line-height: 1.04; letter-spacing: -0.04em; font-weight: 700; margin: 0 0 20px; text-wrap: balance; }
  .lede { font-size: clamp(17px, 1.5vw, 19px); color: var(--ink-2); margin: 0; max-width: 34em; text-wrap: pretty; }
  .hero-links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }

  .install-card { background: var(--bg-raised); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 20px; box-shadow: var(--shadow); min-width: 0; }
  .install-card :global(.copycmd code) { white-space: normal; overflow-wrap: anywhere; line-height: 1.5; font-size: 13.5px; }
  .card-label { font: 12.5px var(--font-mono); color: var(--ink-3); margin: 0 0 10px; }
  .agent-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .agent-tabs button { height: 32px; padding: 0 11px; border-radius: 8px; border: 1px solid var(--line-strong); background: transparent; color: var(--ink-2); font: 500 13.5px var(--font-sans); cursor: pointer; }
  .agent-tabs button:hover { color: var(--ink); border-color: var(--ink-3); }
  .agent-tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .path, .then { font-size: 13.5px; color: var(--ink-3); margin: 12px 0 0; overflow-wrap: anywhere; }
  .then { padding-top: 12px; border-top: 1px solid var(--line); }
  .path code, .then code { font-size: 12.5px; color: var(--ink); }

  .stats { list-style: none; margin: clamp(48px, 7vw, 80px) 0 0; padding: 22px 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--line); }
  .stats li { display: flex; align-items: baseline; gap: 10px; font-size: 15px; color: var(--ink-3); }
  .stats li + li { padding-left: 20px; border-left: 1px solid var(--line); }
  .stats b { font-size: clamp(26px, 3vw, 34px); font-weight: 700; letter-spacing: -0.03em; color: var(--ink); }
  @media (max-width: 880px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 0; }
    .stats li:nth-child(3) { padding-left: 0; border-left: 0; }
  }

  /* Section rows: label left, content right */
  .sec { padding: clamp(56px, 8vw, 96px) 0; }
  .sec + .sec { border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(24px, 5vw, 64px); }
  .label { position: sticky; top: 88px; align-self: start; }
  .label h2 { font-size: clamp(24px, 2.4vw, 30px); letter-spacing: -0.03em; font-weight: 700; margin: 0 0 8px; line-height: 1.15; }
  .label p { color: var(--ink-3); font-size: 15px; margin: 0; }
  @media (max-width: 880px) { .row { grid-template-columns: minmax(0, 1fr); } .label { position: static; } }

  /* How it works */
  .steps { list-style: none; margin: 0 0 28px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .steps li { padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-raised); }
  .steps .n { font: 12.5px var(--font-mono); color: var(--flash-text); }
  .steps h3 { font-size: 17px; margin: 8px 0 4px; letter-spacing: -0.01em; }
  .steps p { margin: 0; font-size: 14.5px; color: var(--ink-2); line-height: 1.5; }
  @media (max-width: 680px) { .steps { grid-template-columns: minmax(0, 1fr); } }

  /* Compare */
  .compare { border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-raised); }
  .c-head, .c-row { display: grid; grid-template-columns: 1fr 1fr; }
  .c-head span { padding: 12px 18px; font: 500 12.5px var(--font-mono); color: var(--ink-3); background: var(--bg-sunk); border-bottom: 1px solid var(--line); }
  .c-row span { padding: 13px 18px; font-size: 15.5px; display: flex; gap: 10px; align-items: baseline; }
  .c-row + .c-row span { border-top: 1px solid var(--line); }
  .c-head span + span, .c-row span + span { border-left: 1px solid var(--line); }
  .no { color: var(--ink-3); }
  .no::before { content: '×'; color: var(--fail); font-weight: 700; }
  .yes::before { content: '✓'; color: var(--pass); font-weight: 700; }
  .c-row { transition: background-color .15s; }
  .c-row:hover { background: var(--bg-sunk); }

  /* Explorer */
  .filters { display: grid; gap: 10px; margin-bottom: 18px; }
  .frow { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .flabel { font: 12.5px var(--font-mono); color: var(--ink-3); width: 52px; }
  .fchip { height: 32px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--ink-2); font: 500 13.5px var(--font-sans); cursor: pointer; }
  .fchip span { font: 11.5px var(--font-mono); color: var(--ink-3); margin-left: 2px; }
  .fchip:hover { color: var(--ink); border-color: var(--ink-3); }
  .fchip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .fchip[aria-pressed='true'] span { color: color-mix(in srgb, var(--bg) 65%, transparent); }
  .search { display: flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--bg-raised); color: var(--ink-3); max-width: 460px; }
  .search:focus-within { border-color: var(--ink); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: 15px var(--font-sans); color: var(--ink); }
  .count { font: 12.5px var(--font-mono); color: var(--ink-3); margin: 0 0 12px; }
  .count b { color: var(--ink); font-weight: 500; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 8px; }
  .grid li[hidden] { display: none; }
  .grid a { display: flex; flex-direction: column; gap: 5px; height: 100%; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-raised); text-decoration: none; transition: border-color .15s, transform .15s; }
  .grid a:hover, .grid a:focus-visible { border-color: var(--ink); transform: translateY(-1px); }
  .meta { display: flex; gap: 8px; align-items: center; font: 11.5px var(--font-mono); color: var(--ink-3); }
  .badge { padding: 1px 6px; border-radius: 4px; background: var(--bg-sunk); color: var(--ink-2); }
  .b-router { background: var(--flash); color: var(--flash-ink); }
  .b-principle { background: transparent; box-shadow: inset 0 0 0 1px var(--line-strong); }
  .nm { font-weight: 600; font-size: 15.5px; letter-spacing: -0.01em; }
  .ds { font-size: 13.5px; color: var(--ink-3); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .more { margin-top: 12px; width: 100%; height: 46px; border-radius: var(--radius); border: 1px dashed var(--line-strong); background: transparent; color: var(--ink-2); font: 500 14.5px var(--font-sans); cursor: pointer; }
  .more:hover { color: var(--ink); border-color: var(--ink); }
  .more[hidden] { display: none; }
  .empty { color: var(--ink-2); }
  .empty button { font: inherit; color: var(--flash-text); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }

  /* FAQ */
  .faq details { border-bottom: 1px solid var(--line); }
  .faq details:first-child { border-top: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; padding: 16px 32px 16px 0; font-size: 16.5px; font-weight: 500; position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 2px; top: 12px; font: 400 22px var(--font-mono); color: var(--ink-3); transition: transform .2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq summary:hover { color: var(--flash-text); }
  .faq p { margin: -4px 0 18px; color: var(--ink-2); font-size: 15.5px; max-width: 40em; }
  .faq :global(code) { font-size: .86em; background: var(--bg-sunk); padding: 1px 5px; border-radius: 5px; }
  .faq :global(a) { color: var(--flash-text); }

  /* CTA */
