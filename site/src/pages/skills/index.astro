---
import Base from '../../layouts/Base.astro';
import { getSkills, counts, groupLabels, roles } from '../../lib/skills';

const skills = getSkills();
const c = counts();
const filters = [
  { id: 'all', label: 'All', n: c.total },
  { id: 'router', label: 'Router', n: 1 },
  ...['design', 'frontend', 'shipping', 'session', 'advanced'].map((g) => ({ id: g, label: groupLabels[g], n: skills.filter((s) => s.group === g).length })),
  { id: 'helper', label: 'Helpers', n: c.helpers },
  { id: 'principle', label: 'Principles', n: c.principles },
];
const typeLabel = { router: 'Router', playbook: 'Playbook', helper: 'Helper', principle: 'Principle' } as const;
---
<Base title="Skills catalog — fstack" description={`Browse all ${c.total} fstack skills: ${c.playbooks} playbooks, ${c.helpers} helpers and ${c.principles} principles for design and frontend work with AI coding agents.`} active="skills">
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">Skills catalog</p>
      <h1 class="h-section">{c.total} skills. One router.</h1>
      <p class="lede">{c.playbooks} playbooks for multi-step work, {c.helpers} helpers you can call directly, and {c.principles} principles the router applies on its own.</p>
      <div class="controls">
        <label class="search">
          <span class="sr-only">Search skills</span>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" id="q" placeholder="Search: figma, a11y, PR, tokens…" autocomplete="off" />
        </label>
        <div class="filters" role="group" aria-label="Filter by group">
          {filters.map((f, i) => <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label} <span>{f.n}</span></button>)}
        </div>
      </div>
    </div>
  </section>

  <section class="list-sec">
    <div class="wrap">
      <p class="count" aria-live="polite"><span id="shown">{c.total}</span> skills<span id="role-note" hidden> for <b id="role-name"></b> · <button type="button" id="role-clear">show all</button></span></p>
      <ul class="grid" id="grid">
        {skills.map((s) => (
          <li data-type={s.type} data-group={s.group} data-roles={roles.filter((r) => r.slugs.includes(s.slug)).map((r) => r.id).join(' ')} data-text={`${s.name} ${s.description}`.toLowerCase()}>
            <a href={`/skills/${s.slug}`}>
              <span class="meta"><span class={`t t-${s.type}`}>{typeLabel[s.type]}</span>{s.type === 'playbook' && <span class="g">{groupLabels[s.group]}</span>}</span>
              <span class="nm">{s.type === 'helper' || s.type === 'router' ? `/${s.name}` : s.name}</span>
              <span class="ds">{s.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="empty" id="empty" hidden>No skills match. Try <button type="button" id="reset">clearing the filters</button>.</p>
    </div>
  </section>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#grid li'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const shown = document.getElementById('shown')!;
  const empty = document.getElementById('empty')!;
  let filter = 'all';
  const roleNames: Record<string, string> = {product: 'product designers', ux: 'UX designers', ui: 'UI designers', frontend: 'frontend developers'};
  let role = new URLSearchParams(location.search).get('role') || '';
  if (!roleNames[role]) role = '';
  const roleNote = document.getElementById('role-note')!;
  const apply = () => {
    const term = q.value.trim().toLowerCase();
    let n = 0;
    items.forEach((li) => {
      const okF = (filter === 'all' || li.dataset.type === filter || li.dataset.group === filter)
        && (!role || (li.dataset.roles || '').split(' ').includes(role));
      const okQ = !term || term.split(/\s+/).every((t) => li.dataset.text!.includes(t));
      li.hidden = !(okF && okQ);
      if (!li.hidden) n++;
    });
    shown.textContent = String(n);
    roleNote.hidden = !role;
    if (role) document.getElementById('role-name')!.textContent = roleNames[role];
    empty.hidden = n !== 0;
  };
  buttons.forEach((b) => b.addEventListener('click', () => {
    filter = b.dataset.filter!;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  }));
  q.addEventListener('input', apply);
  document.getElementById('reset')!.addEventListener('click', () => { q.value = ''; buttons[0].click(); q.focus(); });
  document.getElementById('role-clear')!.addEventListener('click', () => {
    role = '';
    const u = new URL(location.href); u.searchParams.delete('role'); history.replaceState(null, '', u);
    apply();
  });
  const params = new URLSearchParams(location.search);
  const wanted = params.get('group') || params.get('type');
  const match = wanted && buttons.find((b) => b.dataset.filter === wanted);
  if (match) match.click();
  if (params.get('q')) { q.value = params.get('q')!; apply(); }
  buttons.forEach((b) => b.addEventListener('click', () => {
    const u = new URL(location.href);
    if (filter === 'all') u.searchParams.delete('group'); else u.searchParams.set('group', filter);
    history.replaceState(null, '', u);
  }));
  apply();
</script>

<style>
  .head { padding: clamp(48px, 7vw, 88px) 0 28px; }
  .controls { margin-top: 36px; display: grid; gap: 14px; }
  .search { display: flex; align-items: center; gap: 10px; height: 50px; padding: 0 16px; border-radius: var(--radius); background: var(--bg-raised); box-shadow: var(--shadow); color: var(--ink-3); max-width: 560px; }
  .search:focus-within { box-shadow: var(--shadow), 0 0 0 2px var(--flash); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: 16px var(--font-sans); color: var(--ink); }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .filters button { height: 34px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--ink-2); font: 500 14px var(--font-sans); cursor: pointer; }
  .filters button span { color: var(--ink-3); font: 12px var(--font-mono); margin-left: 3px; }
  .filters button:hover { color: var(--ink); border-color: var(--ink-3); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .filters button[aria-pressed='true'] span { color: color-mix(in srgb, var(--bg) 65%, transparent); }
  .list-sec { padding-bottom: 80px; }
  .count { font: 13px var(--font-mono); color: var(--ink-3); margin: 0 0 14px; }
  .count b { color: var(--ink); font-weight: 500; }
  .count button { font: inherit; color: var(--flash-text); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .grid li[hidden] { display: none; }
  .grid a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 18px 20px 20px; border-radius: var(--radius-lg); background: var(--bg-raised); box-shadow: var(--shadow); text-decoration: none; transition: transform .15s ease; }
  .grid a:hover { transform: translateY(-2px); }
  .meta { display: flex; gap: 8px; align-items: center; font: 500 12px var(--font-mono); color: var(--ink-3); }
  .t { padding: 2px 7px; border-radius: 5px; background: var(--bg-sunk); color: var(--ink-2); }
  .t-router { background: var(--flash); color: var(--flash-ink); }
  .t-principle { background: transparent; box-shadow: inset 0 0 0 1px var(--line-strong); }
  .nm { font-weight: 600; font-size: 18px; letter-spacing: -0.01em; font-family: var(--font-mono); font-size: 16px; }
  .ds { font-size: 14.5px; color: var(--ink-2); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .empty { color: var(--ink-2); }
  .empty button { font: inherit; color: var(--flash-text); background: none; border: 0; padding: 0; text-decoration: underline; cursor: pointer; }
</style>
